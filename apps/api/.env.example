DATABASE_URL=postgresql://supercables:supercables@localhost:5432/supercables
PORT=3000
# Public base URL the CPO uses to reach our OCPI endpoints.
PUBLIC_URL=http://localhost:3000
# Our OCPI identity.
OCPI_COUNTRY_CODE=NO
OCPI_PARTY_ID=SCB
# Shared secret for /admin endpoints (sent as X-Admin-Key). Replace before deploying anywhere.
ADMIN_API_KEY=change-me-admin
# HMAC secret for device access tokens. Replace before deploying anywhere.
DEVICE_JWT_SECRET=change-me-device-jwt
